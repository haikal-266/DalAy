{
  "expo": {
    "name": "DalAy",
    "slug": "dalay",
    "scheme": "dalay",
    "version": "4.5.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kallkun.dalay",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSCameraUsageDescription": "Izinkan DalAy mengakses kamera untuk memotret struk belanja.",
        "NSPhotoLibraryUsageDescription": "Izinkan DalAy mengakses galeri untuk memilih foto struk belanja.",
        "NSMicrophoneUsageDescription": "Izinkan DalAy mengakses mikrofon untuk pencatatan transaksi dan pencarian dengan suara.",
        "NSSpeechRecognitionUsageDescription": "Izinkan DalAy menggunakan pengenalan suara untuk fitur voice input.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kallkun.dalay",
      "adaptiveIcon": {
        "backgroundColor": "#042F2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0D9488"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan DalAy mengakses galeri untuk memilih foto struk belanja.",
          "cameraPermission": "Izinkan DalAy mengakses kamera untuk memotret struk belanja."
        }
      ],
      "expo-sharing",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Izinkan DalAy mengakses mikrofon untuk pencatatan transaksi dan pencarian dengan suara.",
          "speechRecognitionPermission": "Izinkan DalAy menggunakan pengenalan suara untuk fitur voice input."
        }
      ],
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "e758e0c2-5e79-4028-9047-f04492a5d4cc"
      }
    }
  }
}
